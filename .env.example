# Trimbin — environment variables
# Copy to .env and fill in your values

# Required — core
LETTERBOXD_USER=your-letterboxd-username
RADARR_URL=http://radarr:7878
RADARR_API_KEY=your-radarr-api-key

# Optional — qBittorrent integration (purge torrent listings on trim)
# When a movie/show is trimmed, the matching torrent is removed from qBit.
# Point this at your main qBit instance (not MAM-specific).
QBIT_URL=http://qbittorrent:8080
QBIT_USERNAME=admin
QBIT_PASSWORD=

# Optional — Simkl integration (watched movies + shows + anime)
# Create an app at https://simkl.com/settings/developer/new/ to get client_id.
# Then run the PIN auth flow to get an access token (tokens never expire):
#   1. Visit https://api.simkl.com/oauth/pin?client_id=YOUR_CLIENT_ID
#   2. Go to https://simkl.com/pin/ and enter the code
#   3. Poll the verification URL to get your access_token
SIMKL_CLIENT_ID=
SIMKL_ACCESS_TOKEN=

# Optional — Sonarr integration (show trimming)
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=

# Optional — Jellystat integration (multi-user watch counts)
# Requires Jellystat running alongside Jellyfin. Get your API key from Jellystat settings.
JELLYSTAT_URL=http://jellystat:3000
JELLYSTAT_API_KEY=

# Optional — Jellyfin integration (TMDB-to-Jellyfin ID mapping for Jellystat)
# Needed for Jellystat watch counts. Get an API key from Jellyfin > Dashboard > API Keys.
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=

# Optional — notifications and monitoring
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook
DATA_DIR=/data
HC_PING_URL=https://healthchecks.example.com/ping/your-uuid
PORT=5380
