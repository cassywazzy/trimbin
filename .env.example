# Trimbin — environment variables
# Copy to .env and fill in your values

# Required — core
LETTERBOXD_USER=your-letterboxd-username
RADARR_URL=http://radarr:7878
RADARR_API_KEY=your-radarr-api-key

# Optional — Trakt integration (watched movies + shows)
# Create an app at https://trakt.tv/oauth/applications/new to get a client ID.
# Only the client_id is needed — no OAuth required for public profiles.
TRAKT_CLIENT_ID=
TRAKT_USERNAME=your-trakt-username

# Optional — Sonarr integration (show trimming)
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=

# Optional — Jellystat integration (multi-user watch counts)
# Requires Jellystat running alongside Jellyfin. Get your API key from Jellystat settings.
JELLYSTAT_URL=http://jellystat:3000
JELLYSTAT_API_KEY=

# Optional — Jellyfin integration (TMDB-to-Jellyfin ID mapping for Jellystat)
# Needed for Jellystat watch counts. Get an API key from Jellyfin > Dashboard > API Keys.
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=

# Optional — notifications and monitoring
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook
DATA_DIR=/data
HC_PING_URL=https://healthchecks.example.com/ping/your-uuid
PORT=5380
